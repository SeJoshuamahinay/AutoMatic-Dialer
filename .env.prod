# Production Environment Configuration
API_BASE_URL=https://dashboard.lenderly.ph/
API_TIMEOUT=15000
DEBUG_MODE=false

# Auth Configuration - Sanctum Token-based
AUTH_ENDPOINT=/api/auth/sanctum/login
USER_INFO_ENDPOINT=/api/auth/sanctum/me
LOGOUT_ENDPOINT=/api/auth/sanctum/logout
LOGOUT_ALL_ENDPOINT=/api/auth/sanctum/logout-all
VERIFY_ENDPOINT=/api/auth/sanctum/verify
REFRESH_ENDPOINT=/api/auth/sanctum/refresh

# Sanctum Configuration
DEFAULT_DEVICE_NAME=LenderlyDialer
USE_SANCTUM_AUTH=true

# Feature Flags
ENABLE_LOGGING=true
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false

# Reverb (WebSocket) Configuration - Location Tracking
# App is a client: only the public KEY + host/port/scheme go here. Never the
# APP_SECRET/APP_ID (server-only). HOST/PORT/SCHEME below assume nginx proxies
# wss on 443 (https -> wss) to Reverb on dashboard.lenderly.ph — adjust if
# Reverb is exposed on a raw port or a ws subdomain instead.
# KEY must match whatever the production Reverb server is configured with.
REVERB_HOST=dashboard.lenderly.ph
REVERB_PORT=8002
REVERB_SCHEME=https
REVERB_APP_KEY=5yxoqoiw9co3igm6ktwt
